# Local development (python manage.py runserver). Never commit .env.
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# "local" reads LOCAL_DATA_PATH; "s3" reads S3_BUCKET via the boto3 credential chain
STORAGE_TYPE=local
LOCAL_DATA_PATH=./sample-data
S3_BUCKET=example-package-audit
S3_REGION=us-west-2
